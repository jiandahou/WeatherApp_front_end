{
  "name": "weather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "lighthouse:desktop": "lighthouse http://127.0.0.1:3000/weather/Beijing --preset=desktop --output=json --output=html --output-path=reports/lighthouse/beijing-desktop",
    "lighthouse:mobile": "lighthouse http://127.0.0.1:3000/weather/Beijing --output=json --output=html --output-path=reports/lighthouse/beijing-mobile",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:smoke": "node node_modules/vitest/vitest.mjs run __tests__/smoke",
    "test:e2e": "playwright test",
    "baseline": "node analysis/baseline-snapshot.mjs",
    "audit:boundaries": "node analysis/check-client-boundaries.mjs",
    "migrate:cities": "tsx migrate_cities_advanced.ts",
    "migrate:cities:simple": "tsx migrate_cities.ts"
  },
  "dependencies": {
    "@aws-appsync/utils": "^2.0.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.7.0",
    "animejs": "^3.2.2",
    "aws-amplify": "^6.15.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.511.0",
    "moment": "^2.30.1",
    "motion": "^12.12.1",
    "next": "^14.2.4",
    "openai": "^4.100.0",
    "openmeteo": "^1.1.3",
    "react": "^18",
    "react-dom": "^18",
    "react-redux": "^9.2.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.4"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.16.1",
    "@aws-amplify/backend-cli": "^1.7.2",
    "@next/bundle-analyzer": "^16.2.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/animejs": "^3.1.12",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "aws-cdk-lib": "^2.189.1",
    "constructs": "^10.4.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.6",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  }
}
